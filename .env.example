# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/qio

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=kunal
ADMIN_PASSWORD=admin-123

# Firebase Admin SDK (Firebase Console > Project settings > Service accounts)
FIREBASE_PROJECT_ID=qio-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@qio-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# CORS — Expo / mobile origins (comma-separated)
CORS_ORIGIN=*
